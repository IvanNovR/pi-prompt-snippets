{
  "name": "@ivannovr/pi-prompt-snippets",
  "version": "1.0.0",
  "description": "Pi extension for reusable prompt snippets. Fork of amosblomqvist/pi-config",
  "author": "IvanNovR",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IvanNovR/pi-prompt-snippets.git"
  },
  "homepage": "https://github.com/IvanNovR/pi-prompt-snippets#readme",
  "bugs": "https://github.com/IvanNovR/pi-prompt-snippets/issues",
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension",
    "prompt",
    "snippets",
    "productivity"
  ],
  "type": "module",
  "main": "dist/index.js",
  "pi": {
    "extensions": ["./index.ts"],
    "image": "https://raw.githubusercontent.com/IvanNovR/pi-prompt-snippets/main/docs/assets/menu.png"
  },
  "types": "dist/index.d.ts",
  "files": [
    "index.ts",
    "dist",
    "snippets",
    "docs/assets/*.png",
    "docs/assets/*.gif",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check:commits": "node scripts/check-commits.mjs",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.5.0",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "typescript": "5.9.3"
  }
}
